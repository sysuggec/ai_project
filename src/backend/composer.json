        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "symfony/http-foundation": "^6.0",
        "symfony/routing": "^6.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true
